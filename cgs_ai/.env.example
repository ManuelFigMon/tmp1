# cgs_ai environment configuration -- TEMPLATE
#
# Copy this file to .env and fill in values for your environment:
#     copy .env.example .env         (Windows)
#     cp   .env.example .env         (Linux/macOS)
#
# Rules:
#   * one variable per line, KEY=VALUE
#   * no spaces around '='
#   * lines beginning with # are comments
#   * the real file is named exactly .env (no .txt extension)
#   * NEVER commit .env -- it may hold passwords, tokens or API keys
#
# This template documents every variable the package reads. It contains NO
# real credentials and IS committed, so new users know what to provide.

# --- source code roots -------------------------------------------------------
PS_FOLDER_PATH=\\server\share\cgs_ai\src\ps\
SAS_FOLDER_PATH=\\server\share\cgs_ai\src\sas\
PYTHON_FOLDER_PATH=\\server\share\cgs_ai\src\py

# --- data + source roots -----------------------------------------------------
ROOT_DATA=\\server\share\cgs_ai\data
ROOT_SRC=\\server\share\cgs_ai\src

# --- optional: SMTP for sendEmail --------------------------------------------
SMTP_SERVER=smtp.example.com
SMTP_PORT=25

# --- optional: SQL Server for runSQLServerQuery -------------------------------
SQL_DATA_SOURCE=my.dbserver.CCOM,1433
SQL_LOB_CATALOG=DataMartKYA
