# --- secrets / environment ---------------------------------------------------
# .env may contain passwords, tokens or API keys -- never commit it.
.env
.env.*
!.env.example

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

